{
  "name": "heimrichhannot/contao-location-bundle",
  "type": "contao-bundle",
  "description": "This bundle adds a location entity to contao. ",
  "license": "LGPL-3.0-or-later",
  "require": {
    "php": "^7.4 || ^8.0",
    "contao/core-bundle": "^5.3",
    "heimrichhannot/contao-utils-bundle": "^3.0",
    "symfony/dependency-injection": "^6.4",
    "symfony/http-kernel": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "HeimrichHannot\\LocationBundle\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "HeimrichHannot\\LocationBundle\\ContaoManager\\Plugin"
  },
  "require-dev": {
    "rector/rector": "^2.2",
    "contao/contao-rector": "dev-main"
  }
}
